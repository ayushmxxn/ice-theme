{
  "name": "blazetheme",
  "displayName": "Ice Theme",
  "version": "2.2.4",
  "publisher": "AyushmaanSingh",
  "description": "A clean and modern theme pack for Visual Studio Code.",
  "main": "extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "vscode theme",
    "dark theme",
    "color theme",
    "ice theme",
    "blaze theme",
    "blue theme",
    "minimal",
    "modern",
    "developer",
    "syntax highlighting"
  ],
  "icon": "extension/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushmxxn/ice-theme"
  },
  "bugs": {
    "url": "https://github.com/ayushmxxn/ice-theme/issues"
  },
  "homepage": "https://github.com/ayushmxxn/ice-theme#readme",
  "contributes": {
    "themes": [
      {
        "label": "Ice",
        "uiTheme": "vs-dark",
        "path": "./Ice/themes/ice-color-theme.json"
      },
      {
        "label": "Blaze",
        "uiTheme": "vs-dark",
        "path": "./Blaze/themes/blaze-color-theme.json"
      }
    ]
  }
}
